# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
# 実際の値は secrets.enc.json（SOPS）に入れる。ここは平文をうっかりコミットしないための網
*.tfvars
*.tfvars.json
# 保存した plan（plan -out=...）には変数の値が平文で入る
*.tfplan
*.plan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# 例示用の tfvars はコミットする
!*.tfvars.example

# S3 バックエンドの接続情報（バケット名にアカウント ID が入る）。今は scripts/tf.sh が
# terraform/secrets.enc.env から渡すので使っていないが、平文をうっかりコミットしないため残す
terraform/handson/backend.hcl
terraform/guide/backend.hcl

# 認証情報・秘密情報
*.pem
*.key
secrets/
credentials

# macOS
.DS_Store

# エディタ
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/

# フロントエンド
node_modules/
**/frontend/dist/
*.tsbuildinfo

# Terraform の作業ディレクトリ
terraform/*/.terraform/

# agentcore CLI（handson-agent/ を Runtime にデプロイする設定一式）
# .env.local と .cli/ は agentcore/.gitignore 側でも無視される。ここにも書いておくのは
# 誤って `git add -f` されたときの二重の網。
agentcore/.env.local
agentcore/.cli/

# 手順書サイトのビルド成果物（GitHub Actions がビルドして S3 に置く）
guide/dist/
guide/.astro/
