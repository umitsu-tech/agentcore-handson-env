# 実際の値は terraform/handson/secrets.enc.json（SOPS で暗号化した JSON）に入れる。
# このファイルは変数の一覧と例で、実際に terraform.tfvars として保存する用途では使わない

# 受講者ごとのサブドメインを生やす親ドメイン
base_domain = "handson.example.com"

# *.handson.example.com のワイルドカード証明書。ALB と同じリージョンで発行しておく
certificate_arn = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# base_domain を管理している Cloudflare ゾーンの ID（ゾーンの概要ページに出る）。
# *.handson.example.com の CNAME を ALB に向けるレコードは Terraform が作る。
# API トークンはここに書かず、terraform/secrets.enc.env（環境変数 CLOUDFLARE_API_TOKEN）で渡す
cloudflare_zone_id = "0123456789abcdef0123456789abcdef"

# まずは 1 人で通す。増やすときはここに足す
participants = ["user01"]

# 会場の固定 IP が分かっているなら絞る
# allowed_cidr_blocks = ["203.0.113.0/24"]

# 受講環境を焼いた AMI（scripts/build-ami.sh で作る。焼き直すと terraform.tfvars の値を書き換えてくれる）
ami_id = "ami-00c0b0303a0921d88"

# ルートボリュームのサイズ（GiB）。AMI のルートボリューム（15GiB）以上にする
# root_volume_size = 15

# ハンズオンの終了時刻（RFC3339、オフセット付き）。この時刻を過ぎると受講者ロールから
# Bedrock と Runtime の呼び出しが Deny され、EventBridge Scheduler が EC2 を停止して ALB を消す。
# 当日の apply で設定する。検証のときは書かない（仕組みごと作られない）
# handson_end_time = "2026-10-31T17:00:00+09:00"
# handson_timezone = "Asia/Tokyo"

# 受講者情報の表（/participants.html）を置く手順書サイトのバケット名。
# terraform -chdir=terraform/guide output -raw bucket_name で分かる。未指定なら表は作らない
# guide_bucket_name = "agentcore-handson-guide-123456789012"
