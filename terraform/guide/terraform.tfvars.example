# 実際の値は terraform/guide/secrets.enc.json（SOPS で暗号化した JSON）に入れる。
# このファイルは変数の一覧と例で、実際に terraform.tfvars として保存する用途では使わない

# 独自ドメインを付けるとき。付けないなら両方コメントのままで、CloudFront の既定ドメインで配信する
# guide_hostname     = "guide.handson.example.com"
# cloudflare_zone_id = "0123456789abcdef0123456789abcdef"

# GitHub Actions から自動配信するとき（Issue #52）。ロールを assume できるのはこのリポジトリの main だけ
# github_repository    = "owner/agentcore-handson-env"
# github_owner_id      = 123456      # gh api repos/owner/agentcore-handson-env --jq .owner.id
# github_repository_id = 7890123     # gh api repos/owner/agentcore-handson-env --jq .id

# 受講者情報ページ（/participants.html）の Basic 認証（Issue #58）。合言葉は当日その場で口頭で伝える
# participants_user     = "handson"
participants_password = "change-me-before-apply"
