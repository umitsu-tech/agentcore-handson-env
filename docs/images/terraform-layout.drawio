        <mxCell id="guide-life" value="寿命: 前もって apply → 当日まで置きっぱなし（次回も使うなら destroy しなくてよい）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#F3EEFF;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
