          <mxGeometry x="345" y="403" width="235" height="44" as="geometry" />
        </mxCell>

        <!-- 中央: state の置き場 -->
        <mxCell id="statebox" value="state の置き場（2 ルートで共有）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#7AA116;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#7AA116;" vertex="1" parent="1">
