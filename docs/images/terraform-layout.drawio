<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="26.0.0">
  <diagram id="agentcore-handson-terraform-layout" name="Terraform の管理体系">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Terraform の管理体系" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ルートは受講環境と手順書の 2 つ。寿命が違うので state を分け、置き場は同じ S3 バケットにする。Terraform の外にあるものは下段にまとめた。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5A6C74;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1500" height="24" as="geometry" />
        </mxCell>

        <!-- 左: terraform/handson -->
        <mxCell id="handson" value="terraform/handson/（受講環境）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="560" height="360" as="geometry" />
        </mxCell>
        <mxCell id="handson-life" value="寿命: 当日 apply → 終了後 destroy（終了時刻後は apply せず destroy の一方向）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#FFF0E0;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="handson-backend" value="backend.hcl（git 管理外）&lt;br&gt;bucket = agentcore-handson-assets-&amp;lt;account&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#78909C;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="270" height="54" as="geometry" />
        </mxCell>
        <mxCell id="handson-tfvars" value="terraform.tfvars（git 管理外）&lt;br&gt;証明書 ARN / AMI ID / 終了時刻 など" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#78909C;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="345" y="200" width="235" height="54" as="geometry" />
