        <mxCell id="handson-label" value="作るもの" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="60" y="266" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h-vpc" value="VPC&lt;br&gt;パブリックサブネット 2 AZ" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="295" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h-alb" value="ALB（HTTPS 443）&lt;br&gt;ホスト名で受講者ごとに振り分け" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="345" y="295" width="235" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h-ec2" value="EC2（受講者ごとに 1 台）&lt;br&gt;AMI から起動" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="349" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h-iam" value="IAM ロール&lt;br&gt;受講者用 / Scheduler 用" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
