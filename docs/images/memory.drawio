  <diagram id="memory" name="質問をまたぐと忘れる">
    <mxGraphModel dx="1200" dy="900" background="#faf9f4" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e4e1d4;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="260" as="geometry" /></mxCell>
        <mxCell id="p1t" value="1 つ目の質問" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="q1" value="&lt;b&gt;あなたの質問&lt;/b&gt;&lt;br&gt;モニター借りたいんだけど" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4a7c59;fillColor=#e8eee8;fontSize=14;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="60" y="155" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="in1" value="&lt;b&gt;モデルへの入力&lt;/b&gt;&lt;br&gt;システムプロンプト&lt;br&gt;ツールの一覧&lt;br&gt;質問「モニター借りたいんだけど」" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6b7aa1;fillColor=#eceef3;fontSize=14;fontColor=#211f19;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;答え&lt;/b&gt;&lt;br&gt;空いているのは MON-001 です" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#b0713f;fillColor=#f5ede4;fontSize=14;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8b8678;endArrow=block;endFill=1;" edge="1" parent="1" source="q1" target="in1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8b8678;endArrow=block;endFill=1;" edge="1" parent="1" source="in1" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e4e1d4;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="560" height="260" as="geometry" /></mxCell>
        <mxCell id="p2t" value="2 つ目の質問" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="q2" value="&lt;b&gt;あなたの質問&lt;/b&gt;&lt;br&gt;それ、誰が借りてるの？" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4a7c59;fillColor=#e8eee8;fontSize=14;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="660" y="155" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="in2" value="&lt;b&gt;モデルへの入力&lt;/b&gt;&lt;br&gt;システムプロンプト&lt;br&gt;ツールの一覧&lt;br&gt;質問「それ、誰が借りてるの？」" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6b7aa1;fillColor=#eceef3;fontSize=14;fontColor=#211f19;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;答え&lt;/b&gt;&lt;br&gt;「それ」がどの備品か分かりません" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#b0713f;fillColor=#f5ede4;fontSize=14;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8b8678;endArrow=block;endFill=1;" edge="1" parent="1" source="q2" target="in2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8b8678;endArrow=block;endFill=1;" edge="1" parent="1" source="in2" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gapx" value="1 つ目の質問も答えも入っていない" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#b0713f;" vertex="1" parent="1"><mxGeometry x="660" y="232" width="220" height="24" as="geometry" /></mxCell>
        <mxCell id="mem" value="&lt;b&gt;覚えさせたいなら&lt;/b&gt;。前のやりとりを保存しておいて、次の質問と一緒に渡す。誰が話したか、どこまで渡すか、古いものをいつ捨てるかを自分で面倒見ることになる。これを引き受けるのが &lt;b&gt;AgentCore Memory&lt;/b&gt;。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#4a7c59;fillColor=#f3f5ef;dashed=1;fontSize=14;fontColor=#211f19;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1160" height="80" as="geometry" /></mxCell>
        <mxCell id="m1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4a7c59;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4a7c59;dashed=1;endArrow=block;endFill=1;exitX=0.995;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="mem" target="in2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="190" /></Array></mxGeometry></mxCell>
