<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="26.0.0">
  <diagram id="agentcore-handson-architecture" name="構成図">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AgentCore ハンズオン環境" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="受講者はブラウザだけで参加する。EC2 上の code-server で Strands Agent を編集し、AgentCore CLI で Amazon Bedrock AgentCore Runtime へデプロイする。手順書は S3 + CloudFront で配り、終了時刻で自動停止する。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5A6C74;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="awscloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="1230" height="1230" as="geometry" />
        </mxCell>
        <mxCell id="region" value="Region: ap-northeast-1（東京）" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#879196;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#879196;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="1170" height="930" as="geometry" />
        </mxCell>

        <mxCell id="crossband" value="横断サービス（個別の線は引かない）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#B0BEC5;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#78909C;" vertex="1" parent="1">
