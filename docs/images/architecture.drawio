  <diagram id="agentcore-handson-architecture" name="構成図">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
