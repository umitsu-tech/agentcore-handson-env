          <mxGeometry x="640" y="240" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="Systems Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager_session_manager;" vertex="1" parent="1">
          <mxGeometry x="810" y="240" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="crosstext" value="&lt;b&gt;IAM&lt;/b&gt; — EC2 インスタンスプロファイル（AgentCore のデプロイと呼び出し / Bedrock / SSM）。終了時刻後は Deny&lt;br&gt;&lt;b&gt;ACM&lt;/b&gt; — ワイルドカード証明書（手動発行）。ALB で TLS を終端する&lt;br&gt;&lt;b&gt;Systems Manager&lt;/b&gt; — 管理者のトラブル対応用。受講者は使わない&lt;br&gt;&lt;b&gt;CloudWatch&lt;/b&gt; — AgentCore Runtime のログとトレース（任意）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1055" y="230" width="490" height="90" as="geometry" />
        </mxCell>

        <mxCell id="vpc" value="VPC" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="390" width="690" height="480" as="geometry" />
        </mxCell>
        <mxCell id="subnet" value="Public subnet（2 AZ）" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_subnet;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="425" width="630" height="430" as="geometry" />
        </mxCell>
        <mxCell id="sg" value="Security group — ALB からの 8080 のみ" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#DD344C;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#DD344C;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="585" width="570" height="260" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Elastic Load Balancing&lt;br&gt;インターネット向け ALB / HTTPS 443" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1">
          <mxGeometry x="770" y="464" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="EC2 t4g.small" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="770" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ec2box" value="&lt;b&gt;事前セットアップ済み（AMI から起動）&lt;/b&gt;&lt;br&gt;Amazon Linux 2023 / ARM64 / 受講者 1 人につき 1 台&lt;br&gt;&lt;br&gt;code-server（8080）— コードを書く&lt;br&gt;ハンズオン UI（/proxy/3000/）— 前半も後半もこの画面で動きを見る&lt;br&gt;Strands Agent の雛形 / AgentCore CLI / AWS CDK / uv" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="520" y="715" width="540" height="125" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="Amazon S3&lt;br&gt;コード ZIP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1230" y="450" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="agentcore" value="Bedrock AgentCore Runtime&lt;br&gt;受講者ごとに 1 つ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1">
          <mxGeometry x="1230" y="625" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="Amazon Bedrock&lt;br&gt;Nova 2 Lite" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1460" y="625" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="acbox" value="受講者が自分でデプロイする（1 人 1 つ）&lt;br&gt;Direct Code Deployment / マネージド microVM / ARM64&lt;br&gt;実行ロールは AgentCore CLI が自動で作る&lt;br&gt;モデルは jp.amazon.nova-2-lite-v1:0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#01A88D;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1190" y="770" width="370" height="90" as="geometry" />
        </mxCell>

        <!-- 終了時刻の自動停止 -->
        <mxCell id="shutdown" value="終了時刻の自動停止（handson_end_time）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="450" y="905" width="690" height="165" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="EventBridge Scheduler&lt;br&gt;一回きりのスケジュール" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;" vertex="1" parent="1">
          <mxGeometry x="490" y="945" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="shutdownbox" value="終了時刻に EC2 を全台停止し、ALB を削除する（API を直接呼ぶ。Lambda なし）&lt;br&gt;同じ時刻から受講者ロールに時刻条件の Deny が効き、Bedrock と Runtime を呼べなくなる" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E7157B;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="640" y="950" width="480" height="70" as="geometry" />
        </mxCell>

