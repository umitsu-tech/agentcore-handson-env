<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="26.0.0">
  <diagram id="tool-anatomy" name="ツールの中身">
    <mxGraphModel dx="1200" dy="900" background="#faf9f4" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="code" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e4e1d4;fillColor=#f1efe6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="640" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="@tool" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontFamily=Menlo;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="100" y="106" width="560" height="26" as="geometry" /></mxCell>
        <mxCell id="c2" value="def &lt;b&gt;find_available&lt;/b&gt;(&lt;b&gt;category: str&lt;/b&gt;) -&amp;gt; list[dict]:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontFamily=Menlo;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="100" y="136" width="560" height="26" as="geometry" /></mxCell>
        <mxCell id="c3" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;&quot;&quot;指定したカテゴリで、いま貸出可能な備品を探す。&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Args:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;category: 「ノートPC」「モニター」などのカテゴリ名&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Returns:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;貸出可能な備品のデータの一覧&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;&quot;&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontFamily=Menlo;fontColor=#3a6346;" vertex="1" parent="1"><mxGeometry x="100" y="166" width="560" height="200" as="geometry" /></mxCell>
        <mxCell id="c4" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item for item in _load_equipment()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if item[&quot;category&quot;] == category&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and item[&quot;status&quot;] == &quot;貸出可&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontFamily=Menlo;fontColor=#211f19;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="560" height="130" as="geometry" /></mxCell>
        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#4a7c59;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="58" y="106" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#4a7c59;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="58" y="136" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#4a7c59;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="58" y="166" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#4a7c59;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="58" y="340" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;1. @tool を付けるとツールになる&lt;/b&gt;&lt;br&gt;ただの関数がモデルから見える道具になる" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e4e1d4;fillColor=#FFFFFF;fontSize=14;fontColor=#211f19;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="480" height="70" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;2. 関数名と引数がそのままモデルに渡る&lt;/b&gt;&lt;br&gt;モデルは「find_available を category=モニター で呼んで」と返す&lt;br&gt;値を決めるのはモデル" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6b7aa1;fillColor=#eceef3;fontSize=14;fontColor=#211f19;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="720" y="175" width="480" height="90" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;3. 説明文（docstring）もモデルに渡る&lt;/b&gt;&lt;br&gt;モデルはこれを読んで「今の質問にこのツールが要るか」を決める&lt;br&gt;ここを変えると選び方が変わる" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6b7aa1;fillColor=#eceef3;fontSize=14;fontColor=#211f19;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="480" height="90" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;4. 返すのはデータのまま&lt;/b&gt;&lt;br&gt;dict や list を返す&lt;br&gt;日本語の文章にするのはモデルの仕事で 中身はモデルには見えないただの Python" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#b0713f;fillColor=#f5ede4;fontSize=14;fontColor=#211f19;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="720" y="385" width="480" height="90" as="geometry" /></mxCell>
        <mxCell id="foot" value="agent.py の TOOLS に並べたものだけがモデルから見える（関数を書いただけでは渡らない）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#8b8678;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="900" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
